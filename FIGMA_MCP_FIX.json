{
  "mcpServers": {
    "figma": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "figma-developer-mcp"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "在此处粘贴你的_FIGMA_TOKEN",
        "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Applications/Docker.app/Contents/Resources/bin"
      }
    }
  }
}
